# Copy this file to .env locally or configure these variables in cPanel.
# Never commit the real .env file.

DATABASE_URL=postgresql://username:password@localhost:5432/racinepoir_ludotheque
SECRET_KEY=change-me-to-a-long-random-secret

# Production/self-hosted HTTPS settings.
# Keep these false for plain local http://localhost development.
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
REMEMBER_COOKIE_SAMESITE=Lax
TRUST_PROXY_HEADERS=false

# Optional: BoardGameGeek XML API token.
BGG_API_TOKEN=
