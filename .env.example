# Copy this file to .env locally or configure these variables in cPanel.
# Never commit the real .env file.

DATABASE_URL=postgresql://username:password@localhost:5432/racinepoir_ludotheque
SECRET_KEY=change-me-to-a-long-random-secret

# Production/self-hosted HTTPS settings.
# Keep these false for plain local http://localhost development.
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
REMEMBER_COOKIE_SAMESITE=Lax
TRUST_PROXY_HEADERS=false
LOG_LEVEL=INFO

# In-memory playtest rate limits.
# For multi-worker production, move this state to Redis or another shared store.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
SCAN_CONFIRM_RATE_LIMIT_ATTEMPTS=20
SCAN_CONFIRM_RATE_LIMIT_WINDOW_SECONDS=300

# Optional: BoardGameGeek XML API token.
BGG_API_TOKEN=
